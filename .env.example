MINIPAAS_ADDR=:8080
MINIPAAS_DATABASE_URL=postgres://minipaas:minipaas@localhost:5432/minipaas?sslmode=disable
MINIPAAS_TEST_DATABASE_URL=postgres://minipaas:minipaas@localhost:5432/minipaas_test?sslmode=disable
# *.localtest.me resolves to 127.0.0.1, handy for local routing in Faz 4.
MINIPAAS_DOMAIN=localtest.me
MINIPAAS_API_TOKEN=dev-token-change-me
MINIPAAS_GITHUB_WEBHOOK_SECRET=dev-webhook-secret
MINIPAAS_WORKERS=2

# Build (Faz 2). dryrun | docker (local, Docker Desktop) | buildkit (buildctl → buildkitd)
MINIPAAS_BUILDER=dryrun
MINIPAAS_REGISTRY=localhost:5000
MINIPAAS_REGISTRY_INSECURE=true
MINIPAAS_BUILDKIT_ADDR=tcp://127.0.0.1:1234
# Empty = the builder's own platform. The cluster (t4g) is linux/arm64.
MINIPAAS_BUILD_PLATFORM=
MINIPAAS_BUILD_CACHE=false
MINIPAAS_GIT_BASE_URL=https://github.com
# Only needed for private repositories (fine-grained token, Contents: read).
MINIPAAS_GITHUB_TOKEN=
MINIPAAS_DEPLOY_TIMEOUT=15m

# Deploy (Faz 3). dryrun | kubernetes
MINIPAAS_DEPLOYER=dryrun
# Empty = in-cluster config, else $KUBECONFIG / ~/.kube/config.
MINIPAAS_KUBECONFIG=
MINIPAAS_ROLLOUT_TIMEOUT=3m
# Per container (requests / limits).
MINIPAAS_APP_CPU_REQUEST=25m
MINIPAAS_APP_CPU_LIMIT=500m
MINIPAAS_APP_MEMORY_REQUEST=64Mi
MINIPAAS_APP_MEMORY_LIMIT=256Mi
# Per app namespace (ResourceQuota: requests.cpu, requests+limits.memory, pods).
MINIPAAS_APP_QUOTA_CPU=1
MINIPAAS_APP_QUOTA_MEMORY=4Gi
MINIPAAS_APP_QUOTA_PODS=20
# Rejects images that run as root. Generated Dockerfiles use numeric USERs; a
# repo Dockerfile with a named USER (e.g. "USER node") is rejected too.
MINIPAAS_APP_RUN_AS_NON_ROOT=true
