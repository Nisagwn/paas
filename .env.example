PAAS_ADDR=:8080
PAAS_DATABASE_URL=postgres://paas:paas@localhost:5432/paas?sslmode=disable
PAAS_TEST_DATABASE_URL=postgres://paas:paas@localhost:5432/paas_test?sslmode=disable
# *.localtest.me resolves to 127.0.0.1, handy for local routing in Faz 4.
PAAS_DOMAIN=localtest.me
PAAS_API_TOKEN=dev-token-change-me
PAAS_GITHUB_WEBHOOK_SECRET=dev-webhook-secret
PAAS_WORKERS=2

# Build (Faz 2). dryrun | docker (local, Docker Desktop) | buildkit (buildctl → buildkitd)
PAAS_BUILDER=dryrun
PAAS_REGISTRY=localhost:5000
PAAS_REGISTRY_INSECURE=true
PAAS_BUILDKIT_ADDR=tcp://127.0.0.1:1234
# Empty = the builder's own platform. The cluster (t4g) is linux/arm64.
PAAS_BUILD_PLATFORM=
PAAS_BUILD_CACHE=false
PAAS_GIT_BASE_URL=https://github.com
# Only needed for private repositories (fine-grained token, Contents: read).
PAAS_GITHUB_TOKEN=
PAAS_DEPLOY_TIMEOUT=15m

# Deploy (Faz 3). dryrun | kubernetes
PAAS_DEPLOYER=dryrun
# Empty = in-cluster config, else $KUBECONFIG / ~/.kube/config.
PAAS_KUBECONFIG=
PAAS_ROLLOUT_TIMEOUT=3m
# Per container (requests / limits).
PAAS_APP_CPU_REQUEST=25m
PAAS_APP_CPU_LIMIT=500m
PAAS_APP_MEMORY_REQUEST=64Mi
PAAS_APP_MEMORY_LIMIT=256Mi
# Per app namespace (ResourceQuota: requests.cpu, requests+limits.memory, pods).
PAAS_APP_QUOTA_CPU=1
PAAS_APP_QUOTA_MEMORY=4Gi
PAAS_APP_QUOTA_PODS=20
# Rejects images that run as root. Generated Dockerfiles use numeric USERs; a
# repo Dockerfile with a named USER (e.g. "USER node") is rejected too.
PAAS_APP_RUN_AS_NON_ROOT=true

# Routing (Faz 4). Plain Ingress objects; on a laptop cluster without the
# wildcard certificate use PAAS_INGRESS_TLS=false.
PAAS_INGRESS_CLASS=traefik
PAAS_INGRESS_TLS=false
PAAS_ROUTE_SYNC_INTERVAL=1m

# GitHub integration (Faz 5): commit statuses + PR preview comments, enabled
# when PAAS_GITHUB_TOKEN is set. Token permissions: Contents read, Commit
# statuses read/write, Pull requests read/write (classic token: repo).
PAAS_GITHUB_STATUS=true
PAAS_GITHUB_STATUS_CONTEXT=paas/deploy
PAAS_GITHUB_API_URL=https://api.github.com
# Links in statuses and comments: <PAAS_PUBLIC_URL>/deployments/<id>.
# Empty = https://<PAAS_DOMAIN>.
PAAS_PUBLIC_URL=

# Lifecycle (Faz 7): retention, cleanup and crash recovery.
PAAS_KEEP_PRODUCTION=5
PAAS_PREVIEW_TTL=72h
# 0 = preview aliases are only removed when their branch is deleted.
PAAS_PREVIEW_ALIAS_TTL=0
PAAS_GC_INTERVAL=10m
PAAS_WORKER_STALE_AFTER=2m

# Scale to zero (Faz 11): deployments without requests for this long scale to
# 0 replicas; the first request wakes them (held until a pod is ready).
# 0 disables. Production only sleeps when the app opts in:
#   PUT /api/apps/<app>/scale-to-zero {"production": true}
PAAS_SCALE_TO_ZERO_AFTER=30m
# Idle check interval; empty = min(PAAS_SCALE_TO_ZERO_AFTER/4, 30s).
PAAS_SCALE_INTERVAL=
# The activator receives the requests of sleeping deployments.
PAAS_ACTIVATOR_ADDR=:8081
# IP Traefik dials to reach the activator. In the cluster: the pod IP
# (downward API). Control plane on the host with k3d: host.k3d.internal's IP
# (scripts/k3d-up.sh prints it). Empty = scale to zero stays off.
PAAS_ACTIVATOR_IP=
# "pod": proxy woken requests straight to the pod (in the cluster).
# http://127.0.0.1:80: re-send them through Traefik (control plane on the host).
PAAS_ACTIVATOR_UPSTREAM=pod
# In the cluster: app NetworkPolicies admit the control plane (pod upstream).
PAAS_CONTROL_PLANE_NAMESPACE=
# Traefik metrics for idle detection (defaults: kube-system, 9100).
PAAS_TRAEFIK_NAMESPACE=
PAAS_TRAEFIK_METRICS_PORT=
